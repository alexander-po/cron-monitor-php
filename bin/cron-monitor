#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Standalone CLI entry-point for the cron-monitor SDK.
 *
 * Lets users call ping endpoints from a shell script without booting a
 * Symfony or Laravel container — useful for systemd timers, plain cron
 * jobs in Docker, and CI pipelines that want a heartbeat from a job step.
 *
 * Usage:
 *   vendor/bin/cron-monitor heartbeat <uuid> [--endpoint=URL] [--api-key=KEY] [--body=TEXT]
 *   vendor/bin/cron-monitor start     <uuid> [...]
 *   vendor/bin/cron-monitor success   <uuid> [...]
 *   vendor/bin/cron-monitor fail      <uuid> [...]
 *   vendor/bin/cron-monitor signup    <email> --accept-terms [--endpoint=URL]
 *
 * Exit codes:
 *   0 — ping delivered with 2xx; signup confirmed and the token printed
 *   2 — ping failed at the network or HTTP layer (job continues; this is
 *       intentional so a flaky cron-monitor backend never breaks the
 *       wrapping shell pipeline); signup did not complete
 *   64 — usage error (bad arguments, unknown command, or an environment
 *        that cannot provide an HTTP transport)
 */

exit((function (): int {
    if (\function_exists('ini_set') && \in_array(strtolower((string) \ini_get('display_errors')), ['1', 'on', 'yes', 'true', 'stdout'], true)) {
        ini_set('display_errors', 'stderr');
    }

    $autoloadCandidates = [
        // Standalone vendored install: bin/ -> repo root -> vendor/autoload.php
        __DIR__.'/../vendor/autoload.php',
        // Installed as a Composer dep: bin/ lives in vendor/cron-monitor/php-sdk/bin
        __DIR__.'/../../../autoload.php',
    ];
    foreach ($autoloadCandidates as $candidate) {
        if (file_exists($candidate)) {
            require $candidate;
            break;
        }
    }
    if (!class_exists(CronMonitor\Client\CronMonitorClient::class)) {
        fwrite(\STDERR, "Could not locate the Composer autoloader. Install dependencies with `composer install`.\n");

        return 64;
    }

    $argv = $_SERVER['argv'] ?? [];
    array_shift($argv); // strip script name

    if ([] === $argv || \in_array($argv[0], ['-h', '--help', 'help'], true)) {
        printUsage([] === $argv ? \STDERR : \STDOUT);

        return [] === $argv ? 64 : 0;
    }

    $command = (string) array_shift($argv);
    if (!\in_array($command, ['heartbeat', 'start', 'success', 'fail', 'signup'], true)) {
        fwrite(\STDERR, \sprintf("Unknown command: %s\n", CronMonitor\Api\Internal\SecretRedactor::redact($command)));
        printUsage(\STDERR);

        return 64;
    }

    if ('signup' === $command) {
        return runSignup($argv);
    }

    $uuid = null;
    $endpoint = getenv('CRON_MONITOR_ENDPOINT') ?: CronMonitor\Client\Configuration::DEFAULT_ENDPOINT;
    $apiKey = getenv('CRON_MONITOR_API_KEY') ?: null;
    $body = null;
    $allowInsecure = false;

    foreach ($argv as $arg) {
        if (str_starts_with($arg, '--endpoint=')) {
            $endpoint = substr($arg, 11);
        } elseif (str_starts_with($arg, '--api-key=')) {
            $apiKey = substr($arg, 10);
        } elseif (str_starts_with($arg, '--body=')) {
            $body = substr($arg, 7);
        } elseif ('--allow-insecure' === $arg) {
            $allowInsecure = true;
        } elseif (!str_starts_with($arg, '--') && null === $uuid) {
            $uuid = $arg;
        } else {
            fwrite(\STDERR, \sprintf("Unknown argument: %s\n", CronMonitor\Api\Internal\SecretRedactor::redact($arg)));
            printUsage(\STDERR);

            return 64;
        }
    }

    if (null === $uuid) {
        fwrite(\STDERR, "Missing monitor UUID.\n");
        printUsage(\STDERR);

        return 64;
    }

    if (null === $body && 'fail' === $command) {
        // For the `fail` shorthand, slurp stdin if it's piped — that's the
        // canonical "pipe stderr to cron-monitor on failure" workflow.
        $stdin = stream_get_contents(\STDIN);
        if (\is_string($stdin) && '' !== $stdin) {
            $body = $stdin;
        }
    }

    try {
        $config = new CronMonitor\Client\Configuration(
            endpoint: $endpoint,
            apiKey: $apiKey,
            allowInsecureEndpoint: $allowInsecure,
        );
    } catch (InvalidArgumentException $e) {
        fwrite(\STDERR, \sprintf("Configuration error: %s\n", $e->getMessage()));

        return 64;
    }

    // The bundled cURL transport, so `composer require cron-monitor/php-sdk`
    // stays the only install step this CLI needs.
    try {
        $client = CronMonitor\Client\CronMonitorClient::create($config);
    } catch (Throwable $e) {
        fwrite(\STDERR, \sprintf("Could not build an HTTP transport: %s\n", $e->getMessage()));

        return 64;
    }

    $result = match ($command) {
        'heartbeat' => $client->heartbeat($uuid, $body),
        'start' => $client->start($uuid),
        'success' => $client->success($uuid, $body),
        'fail' => $client->fail($uuid, $body),
    };

    if ($result->delivered) {
        fwrite(\STDOUT, \sprintf("ok %s status=%d attempts=%d\n", $command, $result->statusCode, $result->attempts));

        return 0;
    }

    fwrite(\STDERR, \sprintf(
        "ping failed: %s status=%s attempts=%d\n",
        $result->errorMessage,
        $result->statusCode ?? 'n/a',
        $result->attempts,
    ));

    return 2;
})());

/**
 * @param list<string> $argv
 */
function runSignup(array $argv): int
{
    $email = null;
    $acceptTerms = false;
    $endpoint = getenv('CRON_MONITOR_ENDPOINT') ?: CronMonitor\Client\Configuration::DEFAULT_ENDPOINT;

    foreach ($argv as $arg) {
        if ('--accept-terms' === $arg) {
            $acceptTerms = true;
        } elseif (str_starts_with($arg, '--endpoint=')) {
            $endpoint = substr($arg, 11);
        } elseif (!str_starts_with($arg, '--') && null === $email) {
            $email = $arg;
        } else {
            fwrite(\STDERR, \sprintf("Unknown argument: %s\n", CronMonitor\Api\Internal\SecretRedactor::redact($arg)));
            printUsage(\STDERR);

            return 64;
        }
    }

    if (null === $email) {
        fwrite(\STDERR, "Missing email address.\n");
        printUsage(\STDERR);

        return 64;
    }

    try {
        $config = new CronMonitor\Client\Configuration(endpoint: $endpoint, allowInsecureEndpoint: true);
    } catch (InvalidArgumentException $e) {
        fwrite(\STDERR, \sprintf("Configuration error: %s\n", $e->getMessage()));

        return 64;
    }

    try {
        $api = CronMonitor\Api\MonitorApiClient::create($config);
    } catch (Throwable $e) {
        fwrite(\STDERR, \sprintf("Could not build an HTTP transport: %s\n", $e->getMessage()));

        return 64;
    }

    $command = new CronMonitor\Cli\SignupCommand($api, $endpoint, \STDOUT, \STDERR, static function (int $seconds): void {
        sleep($seconds);
    });

    try {
        return $command->run($email, $acceptTerms);
    } catch (Throwable $e) {
        fwrite(\STDERR, \sprintf("The signup failed: %s\n", CronMonitor\Api\Internal\SecretRedactor::redact($e->getMessage())));

        return 2;
    }
}

/**
 * @param resource $stream
 */
function printUsage($stream): void
{
    $usage = <<<'TXT'
        cron-monitor — ping client for scheduled jobs

        USAGE
          cron-monitor heartbeat <uuid> [--endpoint=URL] [--api-key=KEY] [--body=TEXT]
          cron-monitor start     <uuid> [--endpoint=URL] [--api-key=KEY]
          cron-monitor success   <uuid> [--endpoint=URL] [--api-key=KEY] [--body=TEXT]
          cron-monitor fail      <uuid> [--endpoint=URL] [--api-key=KEY] [--body=TEXT]
          cron-monitor signup    <email> --accept-terms [--endpoint=URL]

        SIGNUP
          Creates an account and its first API token from the terminal. A mail
          with a confirmation link goes to <email>; open it and type the code
          this command shows. It waits for that (up to 30 minutes) and then
          prints CRON_MONITOR_API_KEY=... on standard output, once; everything
          else goes to standard error. --accept-terms states that you agree to
          the Terms of Service ({default_endpoint}/terms) and the Privacy Policy
          ({default_endpoint}/privacy).

        ENVIRONMENT
          CRON_MONITOR_ENDPOINT  default endpoint (default: {default_endpoint})
          CRON_MONITOR_API_KEY   default API key (optional)

        EXAMPLES
          # Heartbeat from a plain cron job:
          * * * * * /opt/scripts/run.sh && cron-monitor heartbeat $UUID

          # Wrap a job with start/success/fail and pipe stderr on failure:
          cron-monitor start $UUID
          if /opt/scripts/run.sh 2> /tmp/err; then
              cron-monitor success $UUID
          else
              cron-monitor fail $UUID --body="$(cat /tmp/err)"
          fi

          # Sign up; only the token line is appended, and only on success, to a
          # git-ignored env file:
          git check-ignore -q .env.local && (umask 077; line=$(cron-monitor signup 'you@example.com' --accept-terms | grep -E '^CRON_MONITOR_API_KEY=cmk_[A-Za-z0-9_-]+$') && printf '\n%s\n' "$line" >> .env.local)

        EXIT CODES
          0   ping delivered with 2xx; signup confirmed, token printed
          2   ping failed at network or HTTP layer; signup did not complete
          64  usage error
        TXT;

    fwrite($stream, str_replace('{default_endpoint}', CronMonitor\Client\Configuration::DEFAULT_ENDPOINT, $usage));
}
